#!/usr/bin/env bash
# CODEX: Offline HTTPS connector installer; payload checksum is embedded at release time.
set -Eeuo pipefail
umask 077
codex_direct_arguments=()
codex_direct_verify=0
codex_direct_pair_file=""
codex_direct_pair_automatic=0
while (($#)); do
    case "$1" in
        --help|-h)
            printf '%s\n' 'Codex Connector — direct HTTPS, no SSH password' \
                'Usage: bash Install-Codex-Connector.sh [--pair-file codex-pairing.json]' \
                'Download your OWN pairing file after the administrator approves your name.' \
                'A pairing file expires after ten minutes and can be used only once.' \
                'A codex-pairing[-VERSION].json beside this installer is detected automatically, including browser-renamed copies.' \
                'Updates keep your existing pairing; a new pairing file is only needed for first setup or explicit repair.' \
                'Uses an installed CPython 3.10–3.14 on Linux x86_64; nothing is installed with sudo.' \
                'The installer will ask before allowing Codex to access your files and terminal.' \
                'Run as your normal Ubuntu desktop user, without sudo.' \
                '--verify checks the package without installing.'
            exit 0 ;;
        --verify) codex_direct_verify=1; shift ;;
        --pair-file)
            if (($# < 2)) || [[ -z "$2" || "$2" == --* ]]; then printf '%s\n' 'Missing pairing file.' >&2; exit 2; fi
            codex_direct_pair_file="$2"; shift 2 ;;
        *) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
    esac
done
for codex_direct_command in awk tail mktemp tar sha256sum; do
    if ! command -v "$codex_direct_command" >/dev/null 2>&1; then
        printf 'Required command is missing: %s\n' "$codex_direct_command" >&2; exit 1
    fi
done
if (( ! codex_direct_verify && EUID == 0 )); then
    printf '%s\n' 'Run as your desktop user, not with sudo.' >&2; exit 1
fi
codex_direct_workdir="$(mktemp -d /tmp/codex-direct-install.XXXXXXXXXX)"
codex_direct_cleanup() {
    # CODEX: Remove only the private, freshly created extraction directory.
    case "$codex_direct_workdir" in /tmp/codex-direct-install.??????????) rm -rf -- "$codex_direct_workdir" ;; esac
}
trap codex_direct_cleanup EXIT
codex_direct_line="$(awk '/^__CODEX_LAN_PAYLOAD_BELOW__$/ { print NR + 1; exit }' "$0")"
if [[ ! "$codex_direct_line" =~ ^[0-9]+$ ]]; then printf '%s\n' 'Package is missing.' >&2; exit 1; fi
tail -n +"$codex_direct_line" -- "$0" > "$codex_direct_workdir/client.tar.gz"
codex_direct_digest="$(sha256sum "$codex_direct_workdir/client.tar.gz")"
if [[ "${codex_direct_digest%% *}" != '@PAYLOAD_SHA256@' ]]; then
    printf '%s\n' 'Package checksum failed. Nothing was installed.' >&2; exit 1
fi
if ((codex_direct_verify)); then printf '%s\n' 'Package verified. Nothing installed.'; exit 0; fi
codex_direct_python=""
codex_direct_python_version=""
for codex_direct_candidate in python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
    codex_direct_executable="$(command -v "$codex_direct_candidate" || true)"
    if [[ -z "$codex_direct_executable" ]]; then continue; fi
    if codex_direct_python_version="$("$codex_direct_executable" -I -c '
import platform, sys
if (sys.implementation.name != "cpython" or not (3, 10) <= sys.version_info[:2] <= (3, 14)
        or sys.platform != "linux" or platform.machine() not in {"x86_64", "AMD64"}
        or "t" in getattr(sys, "abiflags", "")):
    raise SystemExit(1)
print(".".join(map(str, sys.version_info[:3])))
' 2>/dev/null)"; then
        codex_direct_python="$codex_direct_executable"
        break
    fi
done
if [[ -z "$codex_direct_python" ]]; then
    printf '%s\n' 'No compatible Python was found. This offline connector needs CPython 3.10–3.14 on Linux x86_64 (standard build).' \
        'No system packages were changed. Use a compatible Python already installed on this computer.' >&2
    exit 1
fi
printf 'Using Python %s (%s).\n' "$codex_direct_python_version" "$codex_direct_python"
if [[ -z "$codex_direct_pair_file" ]]; then
    codex_direct_installer_dir="${0%/*}"
    if [[ "$codex_direct_installer_dir" == "$0" ]]; then codex_direct_installer_dir=.; fi
    codex_direct_installer_dir="$(cd -- "$codex_direct_installer_dir" && pwd -P)"
    codex_direct_pair_candidate=""
    # CODEX: Browsers append a number on repeated downloads; accept only strict, owned, non-symlink names beside this installer.
    shopt -s nullglob
    codex_direct_pair_candidates=("$codex_direct_installer_dir"/codex-pairing*.json)
    shopt -u nullglob
    for codex_direct_candidate in "${codex_direct_pair_candidates[@]}"; do
        codex_direct_basename="${codex_direct_candidate##*/}"
        if [[ ! "$codex_direct_basename" =~ ^codex-pairing(-[0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4})?(\ \([0-9]+\))?\.json$ ]]; then continue; fi
        if [[ ! -f "$codex_direct_candidate" || ! -O "$codex_direct_candidate" || -L "$codex_direct_candidate" ]]; then continue; fi
        if [[ -z "$codex_direct_pair_candidate" || "$codex_direct_candidate" -nt "$codex_direct_pair_candidate" ]]; then
            codex_direct_pair_candidate="$codex_direct_candidate"
        fi
    done
    if [[ -n "$codex_direct_pair_candidate" ]]; then
        codex_direct_pair_file="$codex_direct_pair_candidate"
        codex_direct_pair_automatic=1
        printf 'Found your pairing file beside the installer (only used for first setup): %s\n' "${codex_direct_pair_file##*/}"
    fi
fi
if [[ -n "$codex_direct_pair_file" ]]; then
    if [[ ! -f "$codex_direct_pair_file" ]]; then
        printf 'Pairing file not found: %s\n' "$codex_direct_pair_file" >&2
        exit 2
    fi
    if ((codex_direct_pair_automatic)); then
        codex_direct_arguments+=(--auto-pair-file "$codex_direct_pair_file")
    else
        codex_direct_arguments+=(--pair-file "$codex_direct_pair_file")
    fi
fi
tar --extract --gzip --file "$codex_direct_workdir/client.tar.gz" --directory "$codex_direct_workdir" --no-same-owner --no-same-permissions
"$codex_direct_python" "$codex_direct_workdir/Codex-LAN-Client/setup_lan_direct.py" "${codex_direct_arguments[@]}"
exit 0
__CODEX_LAN_PAYLOAD_BELOW__
