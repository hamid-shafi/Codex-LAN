# CODEX: Python environments and generated bytecode stay local.
.venv*/
venv/
__pycache__/
*.py[cod]
*$py.class

# CODEX: Test, type-checking, and coverage caches are reproducible outputs.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
coverage.xml
htmlcov/
playwright-report/
test-results/

# CODEX: Dependency wheelhouses and packaged releases are build artifacts.
.lan-wheels/
build/
dist/
releases/
*.egg-info/
*.whl
*.tar.gz
pip.pyz

# CODEX: Runtime databases, logs, sockets, backups, and temporary files are private local state.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log
*.pid
*.sock
*.tmp
*.bak
*.backup

# CODEX: Local credentials and TLS material must never enter repository history.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.csr
*.token

# CODEX: Private installation identity, conversations, and diagnostic reports stay local.
auth.json
admin.token
host-worker.token
device-token
connector.token
codex-pairing*.json
pairing*.json
Install-Codex-Connector*-private*.sh
private-reports/
private-state/
sessions/
uploads/
generated_images/
.codex/
.config/
.local/

# CODEX: Editor and operating-system metadata is machine-specific.
.DS_Store
.idea/
.vscode/
*.swp
*~
